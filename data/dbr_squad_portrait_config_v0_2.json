      "candidate_visibility_rule": "כל מועמד שמופיע בנתוני המועמדים נשאר מוצג; התאמה נמוכה יותר מתבטאת בדירוג נמוך יותר ולא בהסרה."
    },
    "personal_score": {
      "description": "ציון התאמה אישי ראשוני לכל מועמד, לפני חישובי סגל קבוצתיים כמו כפילות, השלמה או גיוון יחסי.",
      "score_range": "0_100",
      "formula_he": "candidate_personal_score = topic_fit*0.80 + public_tone*0.05 + knesset_role*0.06 + information_tolerance*0.04 + proven_vs_potential*0.05",
